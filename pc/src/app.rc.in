#pragma code_page(65001)
// Значок и сведения о файле krenomer.exe. Пути и версию подставляет CMake (configure_file).
#include <winres.h>

1 ICON "@KRENOMER_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KRENOMER_VERSION_COMMA@
 PRODUCTVERSION @KRENOMER_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Регистратор крена — программа для ПК"
            VALUE "FileVersion", "@KRENOMER_VERSION@"
            VALUE "InternalName", "krenomer"
            VALUE "OriginalFilename", "krenomer.exe"
            VALUE "ProductName", "Регистратор крена (BWM427)"
            VALUE "ProductVersion", "@KRENOMER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
