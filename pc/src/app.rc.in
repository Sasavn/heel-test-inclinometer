#pragma code_page(65001)
// Значок и сведения о файле krenomer.exe (Свойства → Подробно). Пути и версию подставляет CMake (configure_file);
// версия — project(VERSION) в CMakeLists.txt, она же kAppVersion (App.hpp, проверяется при сборке).
#include <winres.h>

1 ICON "@KRENOMER_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KRENOMER_VERSION_COMMA@
 PRODUCTVERSION @KRENOMER_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "Регистратор крена"
            VALUE "FileDescription", "Регистратор крена — программа для ПК к прибору кренования"
            VALUE "FileVersion", "@KRENOMER_VERSION_DOTS@"
            VALUE "InternalName", "krenomer"
            VALUE "LegalCopyright", "© 2026, авторы проекта «Регистратор крена»"
            VALUE "OriginalFilename", "krenomer.exe"
            VALUE "ProductName", "Регистратор крена"
            VALUE "ProductVersion", "@KRENOMER_VERSION_DOTS@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
