# ---------------------------------------------------------------------------
# Сборка прошивки
# ---------------------------------------------------------------------------
# STM32CubeIDE (конфигурации Debug/Release)
Debug/
Release/
# make (build/, build_*/: BUILD_DIR=...), сборки host-тестов и симулятора
build*/

# Объектные файлы, зависимости, отчёты GCC
*.o
*.d
*.su
*.cyclo
# Образы и листинги (готовые прошивки в репозиторий не кладём)
*.elf
*.map
*.list
*.hex
*.bin

# ---------------------------------------------------------------------------
# Хостовые инструменты
# ---------------------------------------------------------------------------
# Снимки экрана симулятора интерфейса (выбранные копии — в docs/img/)
BWM427_Inclinometer/tools/ui_sim/out/
# Python
__pycache__/
*.pyc
# Журналы (в т.ч. flash.log, usb_flash.log, usb_diag.log скриптов tools/flash)
*.log

# ---------------------------------------------------------------------------
# Eclipse / STM32CubeIDE / STM32CubeMX: рабочее пространство и личные настройки
# ---------------------------------------------------------------------------
# Рабочее пространство Eclipse (индексы, журналы, история правок)
.metadata/
# Настройки проекта, которые IDE создаёт заново на каждой машине
.settings/
# Конфигурации отладки: содержат абсолютные пути машины
*.launch
# Временный файл CubeMX (пути к репозиторию пакетов пользователя)
mx.scratch
